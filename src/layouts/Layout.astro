---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
      <p id="debug"></p>
      <nav>
        <a href="/home-a">Home A</a> · <a href="/home-b">Home B</a> · <a href="/home-c">Home C</a>
      </nav>
    </main>
    <script>
      import posthog from 'posthog-js';
      import { PUBLIC_POSTHOG_EXPERIMENT_FLAG, PUBLIC_POSTHOG_HOST, PUBLIC_POSTHOG_KEY } from 'astro:env/client';
      import { DISTINCT_ID_COOKIE, VARIANT_COOKIE } from '../lib/posthog';

      const cookie = (name: string) =>
        document.cookie
          .split('; ')
          .find((c) => c.startsWith(`${name}=`))
          ?.slice(name.length + 1);

      const distinctId = cookie(DISTINCT_ID_COOKIE);
      const variant = cookie(VARIANT_COOKIE);

      // Same distinct ID the middleware used, so pageviews/conversions join the exposure.
      posthog.init(PUBLIC_POSTHOG_KEY, {
        api_host: PUBLIC_POSTHOG_HOST,
        person_profiles: 'identified_only',
        bootstrap: distinctId ? { distinctID: distinctId } : undefined,
      });
      if (variant) posthog.register({ [`$feature/${PUBLIC_POSTHOG_EXPERIMENT_FLAG}`]: variant });

      const debug = document.getElementById('debug');
      if (debug) debug.textContent = `distinct_id: ${distinctId ?? '(none)'} · variant: ${variant ?? '(none)'}`;
    </script>
  </body>
</html>
